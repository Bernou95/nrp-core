{
  "engine_gz_grpc" : {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Gazebo Harmonic Grpc Engine",
    "description": "Gazebo Harmonic (gz-sim) Grpc Engine",
    "$id": "#GzGRPCEngine",
    "allOf": [
      { "$ref": "json://nrp-core/engines/engine_comm_protocols.json#/engine_grpc" },
      { "$ref": "json://nrp-core/engines/engines_gazebo.json#/engine_gazebo_base" },
      {
        "properties" : {
          "EngineType": { "enum": ["gz_grpc"] },
          "ProtobufPackages": { "default": ["Gazebo"] },
          "GzHeadlessRendering": {
            "type": "boolean",
            "default": true,
            "description": "Run gz-sim rendering sensors (e.g. cameras) without a display"
          }
        }
      }
    ]
  }
}
