<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="pendulum_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>

    <model name="pendulum">
      <pose>0 0 1 0 0 0</pose>
      <link name="base">
        <inertial>
          <mass>1</mass>
        </inertial>
      </link>
      <joint name="fixed_to_world" type="fixed">
        <parent>world</parent>
        <child>base</child>
      </joint>
      <link name="arm">
        <pose>0 0 -0.25 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
      <joint name="hinge" type="revolute">
        <pose relative_to="base">0 0 0 0 0 0</pose>
        <parent>base</parent>
        <child>arm</child>
        <axis>
          <xyz>1 0 0</xyz>
        </axis>
      </joint>
      <joint name="free_hinge" type="revolute">
        <parent>base</parent>
        <child>tip</child>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
      </joint>
      <link name="tip">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <plugin filename="NRPGzGrpcSystems" name="nrp_gz::NRPJointController">
        <hinge>
          <P>10</P>
          <I>0</I>
          <D>0</D>
          <Type>velocity</Type>
          <Target>0</Target>
        </hinge>
      </plugin>
      <plugin filename="NRPGzGrpcSystems" name="nrp_gz::NRPLinkController"/>
      <plugin filename="NRPGzGrpcSystems" name="nrp_gz::NRPModelController"/>
    </model>
  </world>
</sdf>
